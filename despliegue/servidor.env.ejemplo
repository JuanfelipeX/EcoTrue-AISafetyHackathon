# Configuración del servidor público (se copia a .env.servidor en la máquina; no se sube a git).
# Los 54 mundos salen de la caché calculada con claudecode/sonnet; lo nuevo va a Bedrock (rol de la instancia, sin claves).
LLM_MODELO=claudecode/sonnet
LLM_MODELOS_RESPALDO=bedrock/us.anthropic.claude-sonnet-4-6,bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
ECO_MODO_PUBLICO=1
ECO_HOSTS_PUBLICOS=eco.kibosecondbrain.com
ECO_LIMITE_LLM_DIARIO=300
ECO_LIMITE_PETICIONES_MINUTO=30
# Lo lee cloudflared; el script de despliegue lo toma de AWS SSM Parameter Store (/eco/cloudflare_tunnel_token).
TUNNEL_TOKEN=
