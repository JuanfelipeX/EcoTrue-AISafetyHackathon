# ---------------------------------------------------------------
# ECO - configuración. Copiar este archivo como .env y llenar las claves.
# El archivo .env no se sube al repositorio (está en .gitignore).
# ---------------------------------------------------------------

# Modelo principal, con el formato proveedor/modelo.
# Proveedores soportados: openai, anthropic, openrouter, ollama, claudecode, manual
# Ejemplos:
#   anthropic/claude-haiku-5-5
#   openai/gpt-5-mini
#   openrouter/anthropic/claude-haiku-5.5
#   claudecode/sonnet              (Claude vía la CLI de Claude Code ya iniciada: sin clave de API; corre sin herramientas en una carpeta vacía)
#   ollama/qwen2.5:7b               (modelo local con Ollama: sin clave, sin costo, sin sacar datos del equipo)
#   manual/claude-opus-5-5-sesion   (sin API: usa solo respuestas guardadas en .cache/llm; ver README)
LLM_MODELO=claudecode/sonnet

# Modelos de respaldo, separados por coma. Se prueban en orden si el principal falla.
# El último (manual/...) usa las respuestas guardadas del laboratorio: si todas las APIs fallan
# durante la demo, el mini-internet sigue funcionando.
LLM_MODELOS_RESPALDO=openrouter/anthropic/claude-sonnet-5.5,claudecode/haiku,ollama/qwen2.5:7b,manual/claude-opus-5-5-sesion

# Claves de cada proveedor. Basta con llenar las de los proveedores que se usen.
# OpenRouter: usar una clave de INFERENCIA (sk-or-v1-..., creada en openrouter.ai/settings/keys).
# Una clave de gestión/provisioning no sirve para generar texto (responde 401 "User not found").
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# URL de OpenRouter (no cambiar salvo que lo indique su documentación).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Servidor local de Ollama (https://ollama.com). Solo se usa con modelos ollama/...
OLLAMA_BASE_URL=http://localhost:11434

# Opcional: endpoint compatible con OpenAI (por ejemplo un servidor local). Vacío = API oficial.
OPENAI_BASE_URL=

# Parámetros de generación
LLM_TEMPERATURA=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SEGUNDOS=60

# Caché en disco de respuestas del LLM (1 = activa, 0 = apagada).
# Evita pagar dos veces la misma llamada y sirve de plan B si falla la API durante la demo.
LLM_CACHE=1

# Umbral de similitud de texto (0 a 1) para considerar que dos páginas son copia.
# Lo usan la línea base y la guardia del método híbrido.
ECO_UMBRAL_SIMILITUD=0.6

# Buscador de noticias para analizar noticias reales e investigar temas (https://dashboard.exa.ai)
EXA_API_KEY=
